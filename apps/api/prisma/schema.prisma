// OnniMart — схема бази даних.
// Пояснення до моделей, ER-діаграма та алгоритм зіставлення товарів: docs/02-database.md
//
// Ключова ідея — три рівні каталогу + окремий рівень "картки мережі":
//
//   ProductLine     Coca-Cola                      (лінійка бренду)
//   └─ Product      Coca-Cola Zero                 (смак / різновид)
//      └─ ProductVariant  Coca-Cola Zero 0,5 л     (фасування, має штрихкоди)
//         └─ Listing      АТБ: "Напій Coca-Cola Zero 0,5л"  (картка товару на сайті мережі)
//            └─ PriceSnapshot  49.90 грн, 2026-10-11 10:00   (історія цін)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Довідники
// ============================================================

/// Стан мережі в реєстрі: від кандидата (docs/04-retail-chains.md) до робочого парсера
enum ChainStatus {
  /// Парсер працює, мережа обходиться
  ACTIVE
  /// Парсер є, але збір вимкнено (сайт не працює, тимчасові проблеми)
  PAUSED
  /// Кандидат на розширення: robots.txt, антибот і умови ще не перевірені
  CANDIDATE
  /// Не парситься: антибот-захист, заборона robots.txt, лише застосунок, санкції
  RULED_OUT
}

/// Чи публікує мережа ціни онлайн (попередня оцінка до аудиту)
enum OnlinePrices {
  /// Онлайн-магазин або каталог з цінами всього асортименту
  FULL
  /// Лише акції / листівки або ціни конкретного магазину
  PARTIAL
  /// Невідомо
  UNKNOWN
}

/// Що саме вимірюємо. Кількість завжди зберігається в базових одиницях:
/// MASS — грами, VOLUME — мілілітри, COUNT — штуки.
enum Measure {
  MASS
  VOLUME
  COUNT
}

model Country {
  /// ISO 3166-1 alpha-2: UA, DE, PL
  code     String @id @db.Char(2)
  name     String
  /// ISO 4217: UAH, EUR, USD, JPY…
  currency String @db.Char(3)

  chains StoreChain[]

  @@map("countries")
}

model StoreChain {
  id          String  @id @default(uuid())
  /// Ключ мережі, збігається з назвою парсера: "atb", "silpo", "novus", "lidl-de"
  slug        String  @unique
  name        String
  website     String
  logoUrl     String?
  countryCode String  @db.Char(2)
  /// ISO 4217
  currency    String  @db.Char(3)

  // Реєстр мереж (усі відомі мережі, не лише ті, що парсяться)
  status       ChainStatus  @default(CANDIDATE)
  onlinePrices OnlinePrices @default(UNKNOWN)
  /// Чому вимкнено / відкинуто, що перевірити, звідки брати дані
  notes        String?

  // Параметри збору даних (див. docs/01-data-sources.md)
  scrapeEnabled   Boolean   @default(false)
  /// Пауза між запитами до сайту, мс (не менше Crawl-delay з robots.txt)
  crawlDelayMs    Int       @default(3000)
  /// Щоденний обхід після цієї години UTC, незалежно від SCRAPE_INTERVAL_HOURS: для мереж,
  /// що публікують лише акції (вони стартують у різні дні тижня з початком торгового дня)
  scrapeHourUtc   Int?
  robotsCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country    Country     @relation(fields: [countryCode], references: [code])
  stores     Store[]
  listings   Listing[]
  scrapeRuns ScrapeRun[]

  @@index([countryCode])
  @@index([status])
  @@map("store_chains")
}

/// Фізичний магазин або регіон ціноутворення. Потрібен, коли ціни відрізняються
/// між містами (наприклад, на zakaz.ua ціна прив'язана до конкретного магазину).
model Store {
  id         String   @id @default(uuid())
  chainId    String
  /// ID магазину на сайті мережі
  externalId String?
  name       String
  city       String?
  address    String?
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)

  chain          StoreChain      @relation(fields: [chainId], references: [id], onDelete: Cascade)
  priceSnapshots PriceSnapshot[]

  @@unique([chainId, externalId])
  @@map("stores")
}

model Brand {
  id           String  @id @default(uuid())
  name         String
  /// Нормалізована назва для пошуку та зіставлення: "coca-cola"
  slug         String  @unique
  manufacturer String?

  lines    ProductLine[]
  products Product[]
  aliases  BrandAlias[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "brands_name_trgm_idx")
  @@map("brands")
}

/// Бренд, обʼєднаний модератором з іншим (/admin/brands): ключ дубліката → основний бренд.
/// Воркер підставляє основний бренд у ознаки карток з таким ключем ("sanpellegrino" →
/// San Pellegrino), бо різні ключі брендів — гарантовано різні товари.
model BrandAlias {
  /// Ключ бренду-дубліката (brandKey), як Brand.slug до злиття
  alias     String   @id
  brandId   String
  createdAt DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@map("brand_aliases")
}

/// Канонічне дерево категорій (у кожної мережі своє дерево — воно зберігається
/// в Listing.rawCategory і мапиться сюди).
model Category {
  id       String  @id @default(uuid())
  slug     String  @unique
  name     String
  parentId String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

// ============================================================
// Канонічний каталог
// ============================================================

/// Лінійка бренду: "Coca-Cola", "Галичина Молоко". Групує смаки/різновиди.
model ProductLine {
  id      String  @id @default(uuid())
  name    String
  slug    String  @unique
  brandId String?

  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  products Product[]

  @@map("product_lines")
}

/// Конкретний смак / різновид: "Coca-Cola Zero", "Coca-Cola Cherry".
/// На цьому рівні користувач зазвичай підписується ("будь-яке фасування").
model Product {
  id             String  @id @default(uuid())
  name           String
  slug           String  @unique
  /// Що відрізняє продукт у межах лінійки: "Zero", "Cherry", "Класична"
  variantLabel   String?
  description    String?
  /// Фото за замовчуванням (PRD-35): випадкове з карток мереж, вибране один раз;
  /// воркер (assignImages) міняє його, лише коли такого фото вже немає серед живих карток
  imageUrl       String?
  /// Фото задав модератор в адмінці — assignImages його не змінює
  imageLocked    Boolean @default(false)
  /// Склад, КБЖВ на 100 г, алергени, харчові добавки тощо (напр. з Open Food Facts)
  attributes     Json?
  lineId         String?
  brandId        String?
  categoryId     String?
  /// Категорію задав модератор в адмінці — автоматичне призначення (assignCategories) її не змінює
  categoryLocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  line          ProductLine?     @relation(fields: [lineId], references: [id], onDelete: SetNull)
  brand         Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants      ProductVariant[]
  subscriptions Subscription[]
  views         ProductView[]
  favourites    Favourite[]

  @@index([lineId])
  @@index([brandId])
  @@index([categoryId])
  // Пошук у каталозі: name ILIKE '%q%' (CatalogService.getProducts)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

/// Фасування (SKU): "Coca-Cola Zero 0,5 л", "Coca-Cola Zero 6 × 0,33 л".
/// Саме варіанти порівнюються між мережами і мають штрихкоди.
/// measure / netQuantity порожні, якщо мережа фасування не вказала ("фасування не вказано").
model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  measure     Measure?
  /// Загальна кількість у базових одиницях (г / мл / шт): 6 × 330 мл → 1980
  netQuantity Decimal? @db.Decimal(12, 3)
  /// Кількість одиниць в упаковці (мультипак), для звичайного товару — 1
  packCount   Int      @default(1)
  /// Ваговий товар — ціна на сайті вказана за 1 кг
  isWeighted  Boolean  @default(false)
  /// Тип упаковки, довідково: "ПЕТ", "скло", "з/б"
  packaging   String?
  /// Підпис для інтерфейсу: "0,5 л", "6 × 0,33 л"
  label       String
  /// Фото фасування за замовчуванням (PRD-35), як products.imageUrl, але з карток цього фасування
  imageUrl    String?

  createdAt DateTime @default(now())

  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcodes          Barcode[]
  barcodeCandidates BarcodeCandidate[]
  listings          Listing[]
  subscriptions     Subscription[]
  matchCandidates   MatchCandidate[]
  matchKeys         MatchKey[]

  @@unique([productId, measure, netQuantity, packCount])
  @@map("product_variants")
}

/// Штрихкод (GTIN). В одного фасування їх може бути кілька
/// (різні заводи / країни імпорту), тому це окрема таблиця.
model Barcode {
  /// Нормалізовано до 14 цифр з ведучими нулями (EAN-8/UPC-A/EAN-13/GTIN-14)
  gtin      String   @id @db.VarChar(14)
  variantId String
  /// Звідки дізналися: "silpo", "novus", "openfoodfacts", "user-scan"
  source    String?
  createdAt DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("barcodes")
}

/// PRD-27: сумнівний збіг фасування без штрихкоду мереж з товаром Open Food Facts — черга модерації.
/// Пише `bun run off:match -- --write`; підтверджений GTIN стає barcodes (source 'openfoodfacts-review')
model BarcodeCandidate {
  id        String          @id @default(uuid())
  variantId String
  gtin      String          @db.VarChar(14)
  /// Схожість 0..1 найкращої картки фасування
  score     Float
  /// Як в OFF: «бренди · назва»
  offName   String
  /// Мале фото товару з OFF (image_small_url), щоб модератор бачив упаковку
  imageUrl  String?
  status    CandidateStatus @default(SUGGESTED)
  createdAt DateTime        @default(now())
  decidedAt DateTime?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, gtin])
  @@index([status])
  @@map("barcode_candidates")
}

/// Склад і харчова цінність з Open Food Facts за штрихкодом (ODbL; оновлює scripts/import-food-facts.ts)
/// Без звʼязку з barcodes: окреме джерело, щотижня перезаписується; зʼєднання — за gtin
model FoodFacts {
  /// Як barcodes.gtin: 14 цифр з ведучими нулями
  gtin          String    @id @db.VarChar(14)
  productName   String?
  /// brands OFF: "Quellbrunn, Altmühltaler Quelle" → масив; для пошуку схожих у каталозі
  brands        String[]  @default([])
  /// "1.5l", "500 g" — як на етикетці
  quantity      String?
  /// Мале фото з OFF (для сканера, коли товару ще немає в цінах)
  imageUrl      String?
  /// Склад основною мовою товару
  ingredients   String?
  /// allergens_en: "Milk, Gluten" → ["milk", "gluten"]
  allergens     String[]
  /// labels_tags: en:organic, en:no-gluten…
  labels        String[]
  /// categories_tags: en:breads, en:croissants… — для мультимовних понять (PRD-19)
  categories    String[]
  /// ingredients_analysis_tags: en:vegan, en:palm-oil-free…
  analysis      String[]
  /// На 100 г: energyKcal, fat, saturatedFat, carbohydrates, sugars, fiber, proteins, salt
  nutriments    Json?
  /// a…e
  nutriscore    String?   @db.Char(1)
  /// 1…4
  nova          Int?
  offModifiedAt DateTime?
  importedAt    DateTime  @default(now()) @updatedAt

  @@map("food_facts")
}

// ============================================================
// Дані мереж
// ============================================================

enum MatchStatus {
  /// Ще не зіставлено з каталогом
  PENDING
  /// Зіставлено автоматично (штрихкод або висока схожість)
  AUTO_MATCHED
  /// Підтверджено модератором
  CONFIRMED
  /// Модератор відхилив запропонований варіант
  REJECTED
}

enum MatchMethod {
  BARCODE
  FUZZY
  MANUAL
  /// Схожого товару в каталозі не знайшлося — картка стала основою нового товару
  CREATED
}

/// Картка товару на сайті конкретної мережі ("як є") + посилання на канонічний варіант.
/// Замінює колишні Offer / OfferRaw.
model Listing {
  id          String    @id @default(uuid())
  chainId     String
  /// ID / артикул товару на сайті мережі
  externalId  String
  url         String?
  rawName     String
  rawBrand    String?
  rawCategory String?
  imageUrl    String?
  /// Валідні GTIN-14, знайдені на сторінці (до зіставлення)
  barcodes    String[]
  /// Сирі дані парсера — щоб можна було перепарсити без повторного скрейпінгу
  rawData     Json?
  /// Значущі слова назви (як їх бачить зіставлення) — для частот слів (IDF) у SQL
  nameTokens  String[]
  /// Коли пораховано nameTokens; null — порахувати заново (нова картка, змінилась назва)
  tokenizedAt DateTime?

  // Розпізнана кількість (нормалізація назви, див. catalog/normalization)
  measure     Measure?
  netQuantity Decimal? @db.Decimal(12, 3)
  packCount   Int?
  isWeighted  Boolean  @default(false)

  // Зіставлення з каталогом
  variantId   String?
  matchStatus MatchStatus  @default(PENDING)
  matchMethod MatchMethod?
  /// Впевненість 0..1
  matchScore  Float?
  matchedAt   DateTime?

  // Поточний стан — денормалізовано з останнього PriceSnapshot для швидких запитів
  currentPrice Decimal?  @db.Decimal(12, 2)
  regularPrice Decimal?  @db.Decimal(12, 2)
  /// Ціна за 1 кг / 1 л / 1 шт
  unitPrice    Decimal?  @db.Decimal(12, 2)
  isOnPromo    Boolean   @default(false)
  /// До якого дня діє поточна акція (з сайту); після нього воркер знімає акцію
  promoEndsAt  DateTime?
  inStock      Boolean   @default(true)

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  /// Останній запуск парсера, у якому картку бачили
  lastRunId   String?
  /// Картки немає в останньому повному обході мережі (зникла з сайту, акція закінчилась);
  /// null — картка актуальна. Знімається, щойно картку побачать знову
  delistedAt  DateTime?

  chain           StoreChain       @relation(fields: [chainId], references: [id], onDelete: Cascade)
  variant         ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  priceSnapshots  PriceSnapshot[]
  matchCandidates MatchCandidate[]
  ruleHits        MatchRuleHit[]
  matchKeys       MatchKey[]

  @@unique([chainId, externalId])
  @@index([variantId])
  @@index([matchStatus])
  @@index([chainId, lastRunId])
  @@index([promoEndsAt])
  @@index([tokenizedAt])
  // Пошук і фільтри списку карток (monitoring: buildWhere, getListing, getListings)
  @@index([barcodes], type: Gin)
  @@index([rawName(ops: raw("gin_trgm_ops"))], type: Gin, map: "listings_rawName_trgm_idx")
  @@index([rawBrand(ops: raw("gin_trgm_ops"))], type: Gin, map: "listings_rawBrand_trgm_idx")
  @@index([lastSeenAt(sort: Desc)])
  @@map("listings")
}

enum CandidateStatus {
  /// Запропоновано алгоритмом, чекає рішення модератора
  SUGGESTED
  /// Модератор підтвердив: це той самий товар
  ACCEPTED
  /// Модератор відхилив; цю пару більше не пропонуємо
  REJECTED
}

/// Кандидат на зіставлення з нечіткою схожістю 0,70–0,90 — черга модерації.
/// Рішення модератора зберігаються: це водночас розмічена вибірка для оцінки якості.
model MatchCandidate {
  id        String          @id @default(uuid())
  listingId String
  /// null — фасування видалено (відвʼязування, перебудова), рішення модератора лишається
  variantId String?
  /// Схожість 0..1
  score     Float
  /// Складові оцінки: { name, brand, reason }
  details   Json?
  status    CandidateStatus @default(SUGGESTED)
  createdAt DateTime        @default(now())
  decidedAt DateTime?

  listing Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([listingId, variantId])
  @@index([status])
  @@index([variantId])
  @@map("match_candidates")
}

enum VariationAction {
  /// Слово — варіація завжди (вага 1), навіть якщо дані його не вивчили
  ADD
  /// Слово ніколи не варіація: шум, уточнення ("міні", "milch")
  REMOVE
}

/// Ручні рішення модераторів про слова варіацій (PRD-30, /admin/variations).
/// Воркер накладає їх на вивчений словник на початку кожного пакета зіставлення.
model VariationOverride {
  /// Нормалізоване слово, як у listings.nameTokens ("stracciatella", "куркою")
  word      String          @id
  action    VariationAction
  /// Чому: "смак Almighurt", "уточнення, не смак"
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("variation_overrides")
}

/// Ключі пошуку кандидатів для інкрементального зіставлення — ті самі блоки, що будує
/// CatalogIndex (packages/matching): "VOLUME:500:1|морш" (фасування + перші 4 літери слова)
/// і "b:morshynska" (бренд). Новий пакет читає лише фасування зі спільними ключами,
/// а не весь каталог.
model MatchKey {
  id        BigInt  @id @default(autoincrement())
  key       String
  variantId String
  /// Картка, з назви якої ключ; null — ключ з назви самого товару
  listingId String?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  listing Listing?       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([variantId])
  @@index([listingId])
  @@map("match_keys")
}

/// dHash фото (PRD-33): однакові за вмістом фото різних мереж у галереї товару показуємо раз.
/// Ключ — адреса без домену-дзеркала (imageKey у product-images.ts), а не картка: хеш належить
/// файлу, тож відв'язування картки його не чіпає. Заповнює bun run images:hash.
model ImageHash {
  key       String   @id
  /// 64 біти, 16 hex-символів
  hash      String
  createdAt DateTime @default(now())

  @@map("image_hashes")
}

enum PromoType {
  /// Звичайна знижка (закреслена стара ціна)
  DISCOUNT
  /// "1+1", "2+1", "-30% на другий"
  MULTIBUY
  /// Ціна з карткою лояльності / у застосунку
  LOYALTY
}

/// Історія цін. Новий запис додається лише тоді, коли змінилась ціна,
/// акція або наявність, — інакше оновлюється тільки Listing.lastSeenAt.
model PriceSnapshot {
  id           BigInt     @id @default(autoincrement())
  listingId    String
  /// Регіональна ціна конкретного магазину; null — ціна мережі за замовчуванням
  storeId      String?
  /// Ціна, яку платить покупець
  price        Decimal    @db.Decimal(12, 2)
  /// Закреслена ціна до знижки
  regularPrice Decimal?   @db.Decimal(12, 2)
  unitPrice    Decimal?   @db.Decimal(12, 2)
  promoType    PromoType?
  /// Як акцію підписано на сайті: "-25%", "2+1", "Ціна з карткою"
  promoLabel   String?
  promoEndsAt  DateTime?
  inStock      Boolean    @default(true)
  capturedAt   DateTime   @default(now())
  scrapeRunId  String?

  listing   Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  store     Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  scrapeRun ScrapeRun? @relation(fields: [scrapeRunId], references: [id], onDelete: SetNull)

  @@index([listingId, capturedAt(sort: Desc)])
  @@index([scrapeRunId])
  @@map("price_snapshots")
}

enum ScrapeStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

/// Журнал запусків парсера — для моніторингу та розділу "аналіз роботи системи" у дипломі.
model ScrapeRun {
  id           String       @id @default(uuid())
  chainId      String
  status       ScrapeStatus @default(QUEUED)
  /// "cron" | "manual"
  trigger      String       @default("manual")
  /// Обмеження сторінок на категорію; null — повний обхід (лише він знімає зниклі картки)
  maxPages     Int?
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  pagesFetched Int          @default(0)
  itemsSeen    Int          @default(0)
  itemsChanged Int          @default(0)
  /// Товарів, які не вдалося обробити (потрапили в scraper:results:dead)
  itemsFailed  Int          @default(0)
  error        String?

  chain          StoreChain      @relation(fields: [chainId], references: [id], onDelete: Cascade)
  priceSnapshots PriceSnapshot[]

  @@index([chainId, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@map("scrape_runs")
}

/// Журнал пакетів зіставлення: звіт кожного запуску (для статусу й аналізу роботи системи)
model MatchRun {
  id          String   @id @default(uuid())
  startedAt   DateTime
  finishedAt  DateTime
  /// Скільки незіставлених карток розглянуто
  processed   Int
  byBarcode   Int
  fuzzy       Int
  /// Відправлено на модерацію
  review      Int
  newVariants Int
  newProducts Int
  /// Картку тим часом зіставив хтось інший
  skipped     Int
  /// Помилки окремих карток
  failed      Int

  @@index([startedAt(sort: Desc)])
  @@map("match_runs")
}

/// Перемикач правила зіставлення (/admin/rules; ключі — MATCH_RULES у packages/matching).
/// Рядка немає — правило увімкнене. Воркер читає таблицю на початку кожного пакета.
model MatchingRule {
  key       String   @id
  enabled   Boolean
  updatedAt DateTime @updatedAt

  @@map("matching_rules")
}

/// Правило, що вплинуло на рішення про картку в пакеті зіставлення (/admin/rules).
/// Записи старші за 30 днів видаляє ScrapeScheduler.maintain.
model MatchRuleHit {
  id        String   @id @default(uuid())
  rule      String
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// Рішення пакета: barcode / fuzzy / review / variant / product
  decision  String
  createdAt DateTime @default(now())

  @@index([rule, createdAt(sort: Desc)])
  @@index([listingId])
  @@map("match_rule_hits")
}

// ============================================================
// Користувачі, підписки, сповіщення
// ============================================================

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String?
  /// Google-акаунт (claim sub з ID-токена); null — входив лише паролем
  googleSub          String?   @unique
  name               String?
  locale             String    @default("uk")
  countryCode        String?   @db.Char(2)
  /// Валюта показу цін (ISO 4217); null — валюта країни
  currencyCode       String?   @db.Char(3)
  /// Канали сповіщень
  notifyPush         Boolean   @default(true)
  notifyEmail        Boolean   @default(false)
  /// Повідомляти лише про знижки від N % (0 — будь-яка акція)
  minDiscount        Int       @default(0)
  /// Улюблені мережі (StoreChain.id) — фільтр за замовчуванням для нових підписок
  chainIds           String[]
  /// Категорії з онбордингу (Category.slug) — першими в «Для вас»
  interests          String[]
  /// Згода на збір подій для рекомендацій (PRD-06); null — не погоджувався або відкликав
  telemetryConsentAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  subscriptions Subscription[]
  notifications Notification[]
  devices       PushDevice[]
  sessions      Session[]
  views         ProductView[]
  favourites    Favourite[]
  events        Event[]

  @@map("users")
}

/// Сесія входу: у БД лише SHA-256 токена, сам токен — у httpOnly-cookie вебу
model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Підписка на товар. Заповнюється рівно одне з полів productId / variantId:
/// productId — будь-яке фасування ("Coca-Cola Zero"), variantId — конкретне ("1 л").
model Subscription {
  id            String   @id @default(uuid())
  userId        String
  productId     String?
  variantId     String?
  /// Обмеження по мережах (StoreChain.id); порожній масив — усі мережі
  chainIds      String[]
  /// Повідомити, коли ціна стане ≤ цієї суми
  targetPrice   Decimal? @db.Decimal(12, 2)
  /// Валюта targetPrice: ціни інших валют перераховуються за курсом; null — стара підписка (гривня, якщо є)
  currency      String?  @db.Char(3)
  /// Повідомляти про будь-яку нову акцію
  notifyOnPromo Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Підписки користувачів не зникають разом із товаром: видалення товару з підписками заборонене
  product Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@unique([userId, variantId])
  @@index([productId])
  @@index([variantId])
  @@map("subscriptions")
}

enum NotificationType {
  PRICE_DROP
  PROMO_STARTED
  TARGET_PRICE_REACHED
  BACK_IN_STOCK
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  type      NotificationType
  channel   NotificationChannel @default(PUSH)
  title     String
  body      String
  /// { listingId, variantId, oldPrice, newPrice, chain }
  payload   Json?
  /// Захист від дублікатів: "<subscriptionId>:<priceSnapshotId>"
  dedupeKey String?             @unique
  createdAt DateTime            @default(now())
  sentAt    DateTime?
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Пристрій для push: браузер (Web Push, PWA) або, згодом, мобільний застосунок (Expo)
model PushDevice {
  id            String   @id @default(uuid())
  userId        String
  /// Expo push-токен мобільного застосунку; null — браузер
  expoPushToken String?  @unique
  /// Web Push: адреса push-сервісу браузера і ключі шифрування з PushSubscription
  endpoint      String?  @unique
  p256dh        String?
  auth          String?
  /// "Chrome · Android" — щоб покупець упізнав пристрій у Settings
  label         String?
  /// "ios" | "android" | "web"
  platform      String
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

/// PRD-01: обране («серце») — «я це купую», без сповіщень (сповіщення — subscriptions)
model Favourite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("favourites")
}

/// PRD-04: нещодавно переглянуті — один рядок на товар (повторний перегляд оновлює viewedAt), останні 50
model ProductView {
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, viewedAt])
  @@index([productId])
  @@map("product_views")
}

enum EventType {
  IMPRESSION
  CLICK
  VIEW
  CHAIN_CLICK
  FAVOURITE
  TRACK
  SEARCH
  FILTER
}

/// Події для рекомендацій (AUDIT §9.3) — лише за згодою; зберігаються 180 днів, видаляються з акаунтом.
/// productId / chainId без зовнішніх ключів: журнал не має зникати чи блокувати перебудову каталогу.
model Event {
  id        BigInt    @id @default(autoincrement())
  /// Рівно одне з двох: акаунт або анонімний id гостя (cookie вебу)
  userId    String?
  anonId    String?   @db.Uuid
  sessionId String    @db.Uuid
  type      EventType
  productId String?
  chainId   String?
  query     String?
  /// Позиція в показаному списку (з 0) — для поправки на позицію
  position  Int?
  /// Який список: search, for-you, similar, home-deals…
  listId    String?
  country   String?   @db.Char(2)
  city      String?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([anonId, createdAt])
  @@map("events")
}
