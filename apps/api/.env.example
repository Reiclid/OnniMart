# Скопіюйте в apps/api/.env
DATABASE_URL="postgresql://postgres:change-me-postgres@localhost:5432/onnimart?schema=public"
REDIS_URL="redis://:change-me-redis@localhost:6379"
# Пошук (Meilisearch): без MEILI_URL каталог шукає через SQL ILIKE; ключ — той самий, що MEILI_MASTER_KEY у кореневому .env
MEILI_URL="http://localhost:7700"
MEILI_MASTER_KEY="change-me-meili-master-key"
PORT=3001
# Лише з цього компʼютера; 0.0.0.0 — відкрити в мережу
HOST=localhost
# Звідки браузер може звертатися до API (через кому)
WEB_ORIGINS=http://localhost:3000
# Токен для змін через API (запуск парсингу, модерація); без нього зміни вимкнено.
# Той самий — в apps/web/.env.local
ADMIN_TOKEN=change-me-admin

# Планувальник: повний обхід кожної увімкненої мережі раз на SCRAPE_INTERVAL_HOURS
SCRAPE_SCHEDULE=false
SCRAPE_INTERVAL_HOURS=24

# Формат логів API й воркера: text (за замовчуванням) або json (один JSON-обʼєкт на рядок)
LOG_FORMAT=text

# Вхід через Google (OAuth client «Web application» у Google Cloud Console → APIs & Services → Credentials).
# Без обох змінних кнопка Google на вебі веде на помилку. Той самий GOOGLE_CLIENT_ID — в apps/web/.env.local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
