# Скопіюйте в apps/web/.env.local
# Токен адміністратора — той самий, що ADMIN_TOKEN в apps/api/.env.
# Використовується лише на сервері Next.js (серверні дії), у браузер не потрапляє.
# Ним же веб підписує адресу покупця для лімітів API (без нього всі покупці — одна адреса).
ADMIN_TOKEN=change-me-admin
# Адреса API (для сервера Next.js)
API_URL=http://localhost:3001
# Пароль адмінки (/admin) для доступу не з цього комп'ютера, напр. через тунель (bun run share).
# Без нього адмінка відкривається лише на localhost. Ім'я користувача — будь-яке.
# Довгий випадковий (напр. openssl rand -base64 24): після 10 невдач адресу блокує на 15 хв.
ADMIN_WEB_PASSWORD=
# Email адміністратора — той самий, що ADMIN_EMAIL в apps/api/.env. Задано → /admin лише
# для цього акаунта (вхід через Google), з будь-якої адреси; інші — 404, гості — на вхід.
ADMIN_EMAIL=
# Вхід через Google: той самий Client ID, що в apps/api/.env (секрет — лише в API). Порожній — кнопки немає.
GOOGLE_CLIENT_ID=
# Адреса повернення від Google; має бути в «Authorized redirect URIs» клієнта.
# Порожня — <адреса сайту>/auth/google/callback (для localhost:3000 цього досить)
GOOGLE_REDIRECT_URI=
