{
  "name": "OnniMart",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Вебсистема моніторингу, агрегації та аналізу цін на споживчі товари",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "dev:api": "bun --filter api start:dev",
    "dev:web": "bun --filter web dev",
    "dev:mobile": "bun --filter mobile start",
    "dev:scraper": "cd apps/scraper && cargo run",
    "dev:orval": "cd apps/web && OPENAPI_SPEC=../api/openapi.json bun x orval",
    "dev:migrate": "cd apps/api && bunx prisma migrate dev",
    "dev:generate": "cd apps/api && bunx prisma generate",
    "dev:seed": "cd apps/api && bunx prisma db seed",
    "dev:studio": "cd apps/api && bunx prisma studio",
    "test:api": "bun --filter api test",
    "match:evaluate": "bun --filter api match:evaluate",
    "scraper:cli": "docker compose run --rm scraper scrape",
    "scraper:test": "docker build --target test -t onnimart-scraper:test apps/scraper",
    "dev:openapi": "bun --filter api openapi"
  },
  "keywords": [],
  "author": "Reiclid",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "api": "workspace:*",
    "dotenv": "^17.4.2",
    "turbo": "^2.10.11",
    "typescript": "^6.0.0"
  }
}
