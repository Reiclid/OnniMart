{
  "name": "OnniMart",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "",
  "main": "index.js",
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "dev:api": "bun --filter api start:dev",
    "dev:web": "bun --filter web dev",
    "dev:mobile": "bun --filter mobile start",
    "dev:scraper": "cd apps/scraper && cargo run",
    "dev:orval": "bun --filter web generate:api",
    "dev:migrate": "cd apps/api && bunx prisma migrate dev --name init_schema",
    "dev:generate": "cd apps/api && bunx prisma generate",
    "dev:studio": "cd apps/api && bunx prisma studio"

  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "api": "workspace:*",
    "dotenv": "^17.4.2",
    "turbo": "^2.10.11",
    "typescript": "^6.0.0"
  }
}
