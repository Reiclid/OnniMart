# Змінні для docker-compose (скопіюйте в .env у корені)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=onnimart
# Ключ Meilisearch (від 16 символів); той самий — у apps/api/.env
MEILI_MASTER_KEY=change-me-meili-master-key
# Пароль Redis (обовʼязковий); той самий — у REDIS_URL в apps/api/.env
REDIS_PASSWORD=change-me-redis
# Формат логів скрапера: text (за замовчуванням) або json
LOG_FORMAT=text
